# Образец окружения. Скопировать в .env и заполнить.
# Сам .env в git не попадает — см. .gitignore.

# ── База ─────────────────────────────────────────────────────────────────
# Пароль пользователя gm в контейнере Postgres.
POSTGRES_PASSWORD=

# Строка подключения для API. Локально, когда база поднята через
# docker compose, а сервер запускается из npm:
DATABASE_URL=postgres://gm:ЗАМЕНИТЬ@127.0.0.1:5432/gm

# ── Сервер ───────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Адрес сайта для Caddy. Локально :80, на сервере — домен, тогда Caddy сам
# возьмёт сертификат.
SITE_ADDRESS=:80

# ── Появятся по мере подключения ─────────────────────────────────────────
# Заранее пустыми не добавляются: проверка окружения при старте должна
# что-то значить. Список — в docs/tz/06-BACKEND.md.
#
# PRODAMUS_FORM_URL=
# PRODAMUS_SECRET_KEY=
# AMOCRM_SUBDOMAIN=
# AMOCRM_ACCESS_TOKEN=
# AMOCRM_PIPELINE_ID=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# PUBLIC_SITE_URL=
