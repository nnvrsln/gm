# Caddy: TLS, статика фронтенда, проксирование API.
#
# Домен подставляется через переменную окружения SITE_ADDRESS. Локально это
# `:80`, на сервере — реальное имя, и тогда Caddy сам получает сертификат
# Let's Encrypt и продлевает его без нашего участия.

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# API уходит в контейнер. Статика его не касается: приложение не тратит
	# ни одного цикла на отдачу картинок и шрифтов.
	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv

		# Ассеты собраны с хешем в имени, поэтому кешируются навсегда.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# index.html не кешируем: иначе выкладка не доедет до тех, кто уже
		# открывал страницу.
		header /index.html Cache-Control "no-cache"

		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
